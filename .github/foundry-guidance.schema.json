{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ncosentino/foundry/schemas/foundry-guidance.schema.json",
  "title": "Foundry agent guidance contract",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "agents",
    "docs",
    "adrs",
    "instructions",
    "review"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./foundry-guidance.schema.json"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "agents": {
      "type": "object",
      "required": ["path", "maxLines", "maxBytes", "redirects"],
      "properties": {
        "path": {
          "type": "string",
          "const": "AGENTS.md"
        },
        "maxLines": {
          "type": "integer",
          "const": 60
        },
        "maxBytes": {
          "type": "integer",
          "const": 3072
        },
        "redirects": {
          "type": "object",
          "required": ["claude", "copilot"],
          "properties": {
            "claude": {
              "type": "string",
              "const": "CLAUDE.md"
            },
            "copilot": {
              "type": "string",
              "const": ".github/copilot-instructions.md"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "docs": {
      "type": "object",
      "required": ["root", "mapPath"],
      "properties": {
        "root": {
          "type": "string",
          "const": "docs"
        },
        "mapPath": {
          "type": "string",
          "const": "mkdocs.yml"
        }
      },
      "additionalProperties": false
    },
    "adrs": {
      "type": "object",
      "required": ["root", "filePattern"],
      "properties": {
        "root": {
          "type": "string",
          "const": "docs/adr"
        },
        "filePattern": {
          "type": "string",
          "const": "adr-NNNN-title-slug.md"
        }
      },
      "additionalProperties": false
    },
    "instructions": {
      "type": "object",
      "required": [
        "root",
        "individualReviewThreshold",
        "matchedContext",
        "representativePaths"
      ],
      "properties": {
        "root": {
          "type": "string",
          "const": ".github/instructions"
        },
        "individualReviewThreshold": {
          "type": "object",
          "required": ["lines", "bytes"],
          "properties": {
            "lines": {
              "type": "integer",
              "const": 100
            },
            "bytes": {
              "type": "integer",
              "const": 8192
            }
          },
          "additionalProperties": false
        },
        "matchedContext": {
          "type": "object",
          "required": ["targetLines", "targetBytes", "maxLines", "maxBytes"],
          "properties": {
            "targetLines": {
              "type": "integer",
              "const": 300
            },
            "targetBytes": {
              "type": "integer",
              "const": 16384
            },
            "maxLines": {
              "type": "integer",
              "const": 600
            },
            "maxBytes": {
              "type": "integer",
              "const": 32768
            }
          },
          "additionalProperties": false
        },
        "representativePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "skillPath",
        "instructionResolver",
        "validationInventory",
        "structuralValidator",
        "maxLines",
        "maxBytes"
      ],
      "properties": {
        "skillPath": {
          "type": "string",
          "const": ".github/skills/review-changes/SKILL.md"
        },
        "instructionResolver": {
          "type": "string",
          "const": "scripts/guidance/Get-ApplicableInstructions.ps1"
        },
        "validationInventory": {
          "type": "string",
          "const": "scripts/guidance/Get-ValidationInventory.ps1"
        },
        "structuralValidator": {
          "type": "string",
          "const": "scripts/guidance/Test-Guidance.ps1"
        },
        "maxLines": {
          "type": "integer",
          "const": 200
        },
        "maxBytes": {
          "type": "integer",
          "const": 8192
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
