{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:repository-automation:runtime-distribution:1",
  "title": "Repository automation runtime distribution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "runtime",
    "installation",
    "capabilities"
  ],
  "properties": {
    "$schema": {
      "const": "./runtime-distribution.schema.json"
    },
    "schema_version": {
      "const": "1"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "package_id",
        "version",
        "package_source",
        "package_file",
        "contract_version"
      ],
      "properties": {
        "command": {
          "const": "repository-automation"
        },
        "package_id": {
          "const": "RepositoryAutomation.Tool"
        },
        "version": {
          "$ref": "#/definitions/semanticVersion"
        },
        "package_source": {
          "const": "packages"
        },
        "package_file": {
          "const": "RepositoryAutomation.Tool.0.8.4.nupkg"
        },
        "contract_version": {
          "const": "1"
        }
      }
    },
    "analysis_engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "package_id",
        "version",
        "package_source"
      ],
      "properties": {
        "command": {
          "const": "copilot"
        },
        "package_id": {
          "const": "@github/copilot"
        },
        "version": {
          "const": "1.0.78"
        },
        "package_source": {
          "const": "https://registry.npmjs.org"
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github_hosted",
        "self_hosted",
        "missing_self_hosted_behavior",
        "private_hosted_fallback"
      ],
      "properties": {
        "github_hosted": {
          "enum": [
            "bundled-exact-package",
            "unavailable"
          ]
        },
        "self_hosted": {
          "const": "bundled-exact-package"
        },
        "missing_self_hosted_behavior": {
          "const": "install-bundled-exact-package"
        },
        "private_hosted_fallback": {
          "const": "forbidden"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "runner_variable",
          "hosted_default",
          "physical_reservation"
        ],
        "properties": {
          "id": {
            "enum": [
              "deterministic-control",
              "agentic-maintenance",
              "background-maintenance"
            ]
          },
          "runner_variable": {
            "enum": [
              "REPOSITORY_AUTOMATION_CONTROL_RUNNER",
              "REPOSITORY_AUTOMATION_AGENTIC_RUNNER",
              "REPOSITORY_AUTOMATION_BACKGROUND_RUNNER"
            ]
          },
          "hosted_default": {
            "const": "ubuntu-24.04"
          },
          "physical_reservation": {
            "const": "provider-owned"
          }
        }
      }
    }
  },
  "definitions": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}