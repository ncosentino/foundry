{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:repository-automation:module-policy:1",
  "title": "Repository automation module policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "module",
    "operations",
    "limits",
    "labels",
    "markers",
    "external_output"
  ],
  "properties": {
    "$schema": {
      "enum": [
        "./schemas/module-policy.schema.json",
        "../schemas/module-policy.schema.json"
      ]
    },
    "schema_version": {
      "const": "1"
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/operationKind"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations",
        "labels_per_operation",
        "body_characters",
        "created_issues",
        "relationships",
        "dispatches"
      ],
      "properties": {
        "operations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "labels_per_operation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "body_characters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "body_operations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "created_issues": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "relationships": {
          "type": "integer",
          "minimum": 0,
          "maximum": 22
        },
        "dispatches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    },
    "markers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/marker"
          }
        }
      }
    },
    "external_output": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "disabled"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "sink_id"
          ],
          "properties": {
            "mode": {
              "const": "reference-only"
            },
            "sink_id": {
              "$ref": "#/definitions/identifier"
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "marker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "operationKind": {
      "enum": [
        "issue.labels.update",
        "issue.comment.upsert",
        "issue.body-section.upsert",
        "issue.create",
        "issue.relationship.ensure",
        "issue.relationship.remove",
        "repository.dispatch"
      ]
    }
  }
}
