{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:repository-automation:contract-manifest:1",
  "title": "Repository automation contract manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "contract_version",
    "command",
    "schemas",
    "limits",
    "compatibility"
  ],
  "properties": {
    "$schema": {
      "const": "./schemas/contract-manifest.schema.json"
    },
    "schema_version": {
      "const": "1"
    },
    "contract_version": {
      "const": "1"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "protocol",
        "contract_version_argument",
        "configuration_argument",
        "operations"
      ],
      "properties": {
        "name": {
          "const": "repository-automation"
        },
        "protocol": {
          "const": "stdio-json"
        },
        "contract_version_argument": {
          "const": "--contract-version"
        },
        "configuration_argument": {
          "const": "--configuration"
        },
        "operations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capabilities",
            "analyze",
            "apply"
          ],
          "properties": {
            "capabilities": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "argument",
                "input_schema",
                "output_schema"
              ],
              "properties": {
                "argument": {
                  "const": "capabilities"
                },
                "input_schema": {
                  "type": "null"
                },
                "output_schema": {
                  "const": "schemas/capability-response.schema.json"
                }
              }
            },
            "analyze": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "argument",
                "input_schema",
                "output_schema"
              ],
              "properties": {
                "argument": {
                  "const": "analyze"
                },
                "input_schema": {
                  "const": "schemas/work-request.schema.json"
                },
                "output_schema": {
                  "const": "schemas/analysis-proposal.schema.json"
                }
              }
            },
            "apply": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "argument",
                "input_schema",
                "output_schema"
              ],
              "properties": {
                "argument": {
                  "const": "apply"
                },
                "input_schema": {
                  "const": "schemas/analysis-proposal.schema.json"
                },
                "output_schema": {
                  "const": "schemas/apply-result.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_configuration",
        "module_policy",
        "work_request",
        "analysis_proposal",
        "apply_result",
        "capability_response"
      ],
      "properties": {
        "repository_configuration": {
          "const": "schemas/repository-config.schema.json"
        },
        "module_policy": {
          "const": "schemas/module-policy.schema.json"
        },
        "work_request": {
          "const": "schemas/work-request.schema.json"
        },
        "analysis_proposal": {
          "const": "schemas/analysis-proposal.schema.json"
        },
        "apply_result": {
          "const": "schemas/apply-result.schema.json"
        },
        "capability_response": {
          "const": "schemas/capability-response.schema.json"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_bytes",
        "proposal_bytes",
        "result_bytes",
        "operations_per_proposal"
      ],
      "properties": {
        "request_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "proposal_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "result_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "operations_per_proposal": {
          "const": 32
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_contract_versions",
        "unknown_version_behavior",
        "additive_change_policy",
        "breaking_change_policy",
        "previous_version_support_cycles"
      ],
      "properties": {
        "supported_contract_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": {
            "const": "1"
          },
          "items": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          }
        },
        "unknown_version_behavior": {
          "const": "reject"
        },
        "additive_change_policy": {
          "const": "capability-negotiated-schema-extension"
        },
        "breaking_change_policy": {
          "const": "new-contract-version"
        },
        "previous_version_support_cycles": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
