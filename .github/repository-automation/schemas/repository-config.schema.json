{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:repository-automation:repository-config:1",
  "title": "Repository automation configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "configuration_version",
    "runtime",
    "execution_capabilities",
    "modules"
  ],
  "properties": {
    "$schema": {
      "const": "./schemas/repository-config.schema.json"
    },
    "schema_version": {
      "const": "1"
    },
    "configuration_version": {
      "type": "integer",
      "minimum": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_version",
        "contract_version"
      ],
      "properties": {
        "minimum_version": {
          "$ref": "#/definitions/semanticVersion"
        },
        "contract_version": {
          "const": "1"
        }
      }
    },
    "execution_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic_control",
        "agentic_maintenance",
        "background_maintenance"
      ],
      "properties": {
        "deterministic_control": {
          "const": "deterministic-control"
        },
        "agentic_maintenance": {
          "const": "agentic-maintenance"
        },
        "background_maintenance": {
          "const": "background-maintenance"
        }
      }
    },
    "modules": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/definitions/module"
      }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "eventName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "relativeJsonPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*\\.json$"
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "enabled",
        "execution_class",
        "policy",
        "triggers"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "enabled": {
          "type": "boolean"
        },
        "execution_class": {
          "enum": [
            "deterministic-control",
            "agentic-maintenance",
            "background-maintenance"
          ]
        },
        "policy": {
          "$ref": "#/definitions/relativeJsonPath"
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/definitions/trigger"
          }
        },
        "settings": {
          "oneOf": [
            {
              "$ref": "#/definitions/researchNeededSettings"
            },
            {
              "$ref": "#/definitions/refineWorkSettings"
            },
            {
              "$ref": "#/definitions/radarSettings"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "research-needed"
              }
            }
          },
          "then": {
            "required": [
              "settings"
            ],
            "properties": {
              "settings": {
                "$ref": "#/definitions/researchNeededSettings"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "external-change-radar"
              }
            }
          },
          "then": {
            "properties": {
              "settings": {
                "properties": {
                  "external_url_prefixes": {
                    "minItems": 1
                  },
                  "external_urls": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "enum": [
                  "dependency-radar",
                  "platform-radar",
                  "architecture-drift-radar",
                  "duplication-radar",
                  "cleanup-radar"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "settings": {
                "properties": {
                  "external_url_prefixes": {
                    "maxItems": 0
                  },
                  "external_urls": {
                    "maxItems": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "refine-work"
              }
            }
          },
          "then": {
            "required": [
              "settings"
            ],
            "properties": {
              "settings": {
                "$ref": "#/definitions/refineWorkSettings"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "enum": [
                  "dependency-radar",
                  "platform-radar",
                  "architecture-drift-radar",
                  "duplication-radar",
                  "cleanup-radar",
                  "external-change-radar"
                ]
              }
            }
          },
          "then": {
            "required": [
              "settings"
            ],
            "properties": {
              "settings": {
                "$ref": "#/definitions/radarSettings"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "not": {
                  "enum": [
                    "research-needed",
                    "refine-work",
                    "dependency-radar",
                    "platform-radar",
                    "architecture-drift-radar",
                    "duplication-radar",
                    "cleanup-radar",
                    "external-change-radar"
                  ]
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "settings"
              ]
            }
          }
        }
      ]
    },
    "refineWorkSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_label",
        "completion_label",
        "child_labels",
        "max_children",
        "max_acceptance_criteria",
        "max_non_goals"
      ],
      "properties": {
        "trigger_label": {
          "$ref": "#/definitions/label"
        },
        "completion_label": {
          "$ref": "#/definitions/label"
        },
        "child_labels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/label"
          }
        },
        "max_children": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "max_acceptance_criteria": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_non_goals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      }
    },
    "researchNeededSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_label",
        "completion_label",
        "publish_to_body",
        "allowed_url_prefixes",
        "max_sources",
        "max_source_bytes"
      ],
      "properties": {
        "trigger_label": {
          "$ref": "#/definitions/label"
        },
        "completion_label": {
          "$ref": "#/definitions/label"
        },
        "publish_to_body": {
          "type": "boolean"
        },
        "allowed_url_prefixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^https://[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+/(?:[A-Za-z0-9._~-]+/)*$"
          }
        },
        "max_sources": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "max_source_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        }
      }
    },
    "radarSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_labels",
        "max_findings",
        "max_files",
        "max_file_characters",
        "paths",
        "stale_days",
        "external_url_prefixes",
        "external_urls"
      ],
      "properties": {
        "finding_labels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/label"
          }
        },
        "max_findings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_file_characters": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 12000
        },
        "paths": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9*?][A-Za-z0-9._/*?-]*$"
          }
        },
        "stale_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "publish_external_report": {
          "type": "boolean"
        },
        "external_url_prefixes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^https://[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+/(?:[A-Za-z0-9._~-]+/)*$"
          }
        },
        "external_urls": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^https://[^\\s#]+$"
          }
        }
      }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*$"
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "adapter",
            "event",
            "types"
          ],
          "properties": {
            "kind": {
              "const": "event"
            },
            "adapter": {
              "$ref": "#/definitions/identifier"
            },
            "event": {
              "$ref": "#/definitions/eventName"
            },
            "types": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_-]*$"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "cron"
          ],
          "properties": {
            "kind": {
              "const": "schedule"
            },
            "cron": {
              "type": "string",
              "minLength": 9,
              "maxLength": 100
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "manual"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "adapter",
            "event_type"
          ],
          "properties": {
            "kind": {
              "const": "dispatch"
            },
            "adapter": {
              "$ref": "#/definitions/identifier"
            },
            "event_type": {
              "$ref": "#/definitions/eventName"
            }
          }
        }
      ]
    }
  }
}
