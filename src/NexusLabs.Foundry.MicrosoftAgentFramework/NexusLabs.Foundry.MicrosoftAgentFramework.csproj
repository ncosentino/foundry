<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageDescription>Foundry runtime support for Microsoft Agent Framework. Provides agent construction, workflows, diagnostics, progress, tooling, and generated topology declarations.</PackageDescription>
    <!-- MAF 1.1.0 marked handoff/workflow builder APIs as experimental (MAAIW001).
         Foundry intentionally wraps these in WorkflowFactory. Monitor MAF releases
         for stable replacements. -->
    <NoWarn>$(NoWarn);MAAIW001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <!-- Referenced directly, not left to arrive transitively through Microsoft.Agents.AI. That
         dependency floors Microsoft.Extensions.AI rather than pinning it, so without this the
         centrally managed version is silently ignored and the resolved version is whatever the
         Agent Framework's floor happens to be. -->
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="OpenTelemetry.Api" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NexusLabs.Foundry.MicrosoftAgentFramework.Tests" />
    <InternalsVisibleTo Include="NexusLabs.Foundry.MicrosoftAgentFramework.GeneratedWrapper.Tests" />
    <InternalsVisibleTo Include="NexusLabs.Foundry.MicrosoftAgentFramework.Workflows" />
    <InternalsVisibleTo Include="NexusLabs.Foundry.MicrosoftAgentFramework.Harness" />
    <!-- Non-packable repository example only. This unsupported friend grant is not a
         security boundary and does not promote the selected-provider types to public API. -->
    <InternalsVisibleTo Include="HarnessHybridApp" />
  </ItemGroup>

  <!-- Run Foundry generators and analyzers during source-mode development.
       Consumers reference the standalone packages explicitly. -->
  <ItemGroup>
    <ProjectReference Include="..\NexusLabs.Foundry.MicrosoftAgentFramework.Generators\NexusLabs.Foundry.MicrosoftAgentFramework.Generators.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
    <ProjectReference Include="..\NexusLabs.Foundry.MicrosoftAgentFramework.Analyzers\NexusLabs.Foundry.MicrosoftAgentFramework.Analyzers.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

</Project>
