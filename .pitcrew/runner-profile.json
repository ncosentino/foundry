{
  "$schema": "https://raw.githubusercontent.com/ncosentino/pitcrew/0613544e58e20af67ff414dc3a216b3d1ee842e7/runner-profile.schema.json",
  "schemaVersion": 1,
  "name": "foundry-ci",
  "description": "Foundry repository workers with exact .NET SDKs, NativeAOT prerequisites, and shared automation distribution.",
  "image": "ghcr.io/ncosentino/foundry-runner@sha256:b03be39181c9cce46a680037262e4e2bf4eaeee1539d669a81543980f5f6d8e8",
  "labels": [
    "foundry"
  ],
  "replicas": 2,
  "pullImage": true,
  "disableDefaultLabels": true,
  "readOnlyVolumes": [
    {
      "name": "repository-automation",
      "source": "foundry-repository-automation"
    }
  ],
  "verificationCommands": [
    "test -x /actions-runner/bin/Runner.Listener",
    "dotnet --list-sdks | grep -F '9.0.316'",
    "dotnet --list-sdks | grep -F '10.0.302'",
    "clang --version",
    "pwsh --version",
    "git --version",
    "gh --version",
    "test -f /mnt/pitcrew-data/repository-automation/v0.8.4/files.sha256",
    "printf '9c12dd6a66ded396436a0308d70ebc7b5293134ab5eb0eb341784497d100c7be  /mnt/pitcrew-data/repository-automation/v0.8.4/files.sha256\\n' | sha256sum --check --strict",
    "cd /mnt/pitcrew-data/repository-automation/v0.8.4 && sha256sum --check --strict files.sha256",
    "pwsh -NoProfile -Command '$result = & \"/mnt/pitcrew-data/repository-automation/v0.8.4/contract/conformance/Invoke-RepositoryAutomationConformance.ps1\" -Root \"/mnt/pitcrew-data/repository-automation/v0.8.4/contract\"; if (-not $result.IsClean) { throw ($result.Errors -join \"; \") }'"
  ]
}
